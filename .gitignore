# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# runtime data
/data/

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.playwright-mcp/

# local agent / subagent scratch
/.agents/

# agent worktrees created by EnterWorktree tool — they hold full
# checkouts of the repo plus their own .next/ build artifacts;
# never commit any of it.
/.claude/worktrees/

# manual API harness scripts (sankuai gateway etc.)
scripts/test-*.sh

# typescript
*.tsbuildinfo
next-env.d.ts
