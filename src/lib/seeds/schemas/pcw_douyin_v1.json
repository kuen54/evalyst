{
  "id": "pcw_douyin_v1",
  "label": "商品文案改写 · 抖音脚本风",
  "description": "给定商品参数，让 LLM 写一段 30 秒抖音带货视频脚本。3 schemas 共享 compare_group=product_copywriting_v1，方便从详情页一键对比小红书/朋友圈版本。",
  "version": 1,
  "compare_group": "product_copywriting_v1",
  "inputs": [
    {
      "alias": "p",
      "dataset_id": "product_copywriting_v1",
      "filters": [
        {
          "kind": "multiselect",
          "key": "categories",
          "field": "category",
          "label": "品类",
          "options": [
            { "value": "美妆", "label": "美妆" },
            { "value": "数码", "label": "数码" },
            { "value": "食品饮料", "label": "食品饮料" },
            { "value": "家居", "label": "家居" },
            { "value": "服饰", "label": "服饰" },
            { "value": "母婴", "label": "母婴" }
          ],
          "defaultValue": ["美妆", "数码", "食品饮料", "家居", "服饰", "母婴"]
        },
        { "kind": "number", "key": "limit", "role": "limit", "label": "Limit (blank = all)" }
      ]
    }
  ],
  "variables": [
    { "name": "name", "source": "p.name" },
    { "name": "category", "source": "p.category" },
    { "name": "price", "source": "p.price" },
    { "name": "features", "source": "p.core_features", "transform": [{ "op": "join", "sep": "、" }] },
    { "name": "target_user", "source": "p.target_user" }
  ],
  "default_prompt": "你是抖音带货脚本撰稿人。给定商品信息，输出 30 秒视频脚本。\n\n要求：\n- title：≤ 30 字，钩子式开头（疑问 / 反差 / 数字），引发观众停下来看\n- body：3-5 段视频脚本，每段对应 5-10 秒口播，段落间用空行分隔；包含\"提出问题→展示卖点→对比效果→引导购买\"结构；≤ 400 字\n- hashtags：1-3 个抖音热门标签（不带 # 号，可空）\n- cta：明确的购买引导\n\n输出 JSON：{\"title\": \"...\", \"body\": \"...\", \"hashtags\": [\"...\"], \"cta\": \"...\"}\n\n商品名：{{name}}\n品类：{{category}}\n价格：{{price}}\n核心卖点：{{features}}\n目标用户：{{target_user}}",
  "message_builder": {
    "user_template": "请按上述要求为这个商品写一段抖音脚本，输出 JSON only，不要 markdown 代码块。"
  },
  "output_schema": {
    "type": "object",
    "required": ["title", "body"],
    "properties": {
      "title": { "type": "string", "max_length": 60 },
      "body": { "type": "string", "max_length": 800 },
      "hashtags": { "type": "array", "items": { "type": "string" } },
      "cta": { "type": "string", "max_length": 100 }
    }
  },
  "display_dimensions": [
    {
      "field": "input_preview.p.category",
      "label": "品类",
      "header_fields": [
        { "field": "input_preview.p.name", "label": "商品" },
        { "field": "input_preview.p.target_user", "label": "目标用户" },
        { "field": "input_preview.p.price", "label": "价" }
      ]
    }
  ]
}
