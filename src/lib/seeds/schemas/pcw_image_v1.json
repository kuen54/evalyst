{
  "id": "pcw_image_v1",
  "label": "商品配图",
  "description": "给商品生成配图。本 schema 下挂 3 个 sample experiment（小红书插画 / 抖音封面 / 朋友圈生活感），各自的具体 prompt 见 experiment.prompt_template。Prompt 走英文字段（*_en）以避免生图模型把中文 leak 进画面且渲染错字。Display 仍用中文字段（name/category/...）。",
  "version": 1,
  "compare_group": "product_image_v1",
  "inputs": [
    {
      "alias": "p",
      "dataset_id": "product_copywriting_v1",
      "filters": [
        {
          "kind": "multiselect",
          "key": "categories",
          "field": "category",
          "label": "品类",
          "options": [
            {
              "value": "美妆",
              "label": "美妆"
            },
            {
              "value": "数码",
              "label": "数码"
            },
            {
              "value": "食品饮料",
              "label": "食品饮料"
            },
            {
              "value": "家居",
              "label": "家居"
            },
            {
              "value": "服饰",
              "label": "服饰"
            },
            {
              "value": "母婴",
              "label": "母婴"
            }
          ],
          "defaultValue": [
            "美妆",
            "数码",
            "食品饮料",
            "家居",
            "服饰",
            "母婴"
          ]
        },
        {
          "kind": "number",
          "key": "limit",
          "role": "limit",
          "label": "Limit (blank = all)"
        }
      ]
    }
  ],
  "variables": [
    {
      "name": "name_en",
      "source": "p.name_en"
    },
    {
      "name": "category_en",
      "source": "p.category_en"
    },
    {
      "name": "price_en",
      "source": "p.price_en"
    },
    {
      "name": "features_en",
      "source": "p.core_features_en",
      "transform": [
        {
          "op": "join",
          "sep": ", "
        }
      ]
    },
    {
      "name": "target_user_en",
      "source": "p.target_user_en"
    },
    {
      "name": "name",
      "source": "p.name"
    },
    {
      "name": "category",
      "source": "p.category"
    },
    {
      "name": "price",
      "source": "p.price"
    },
    {
      "name": "features",
      "source": "p.core_features",
      "transform": [
        {
          "op": "join",
          "sep": "、"
        }
      ]
    },
    {
      "name": "target_user",
      "source": "p.target_user"
    }
  ],
  "default_prompt": "You are a product photography stylist. Generate one product image.\n\nStyle:\n- 1:1 square frame\n- soft, magazine-quality natural styling\n- the product is the clear visual subject, with comfortable negative space around it\n\nHard rule:\n- DO NOT render any text, letters, numbers, characters, words, captions, labels, price tags, packaging copy, watermarks, signs, or logos anywhere in the image.\n\nProduct:\n- Name: {{name_en}}\n- Category: {{category_en}}\n- Price: {{price_en}}\n- Core features: {{features_en}}\n- Target user: {{target_user_en}}\n\nReturn the image directly.",
  "message_builder": {
    "user_template": "Generate one image for this product."
  },
  "output_schema": {
    "type": "object",
    "required": [
      "image_url"
    ],
    "properties": {
      "image_url": {
        "type": "image_url"
      },
      "caption": {
        "type": "string",
        "max_length": 200
      }
    }
  },
  "display_dimensions": [
    {
      "field": "input_preview.p.category",
      "label": "品类",
      "header_fields": [
        {
          "field": "input_preview.p.name",
          "label": "商品"
        },
        {
          "field": "input_preview.p.target_user",
          "label": "目标用户"
        },
        {
          "field": "input_preview.p.price",
          "label": "价"
        },
        {
          "field": "input_preview.p.core_features",
          "label": "核心卖点"
        }
      ]
    }
  ],
  "raw_text_output": false
}
